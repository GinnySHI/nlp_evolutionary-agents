# Primary provider: deepseek or hkgai. Each service needs its own key.
EVO_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Alternative backbone. Base URL is ignored while EVO_PROVIDER=deepseek.
HKGAI_API_KEY=
HKGAI_BASE_URL=https://api1.hkgai.net
HKGAI_MODEL=HKGAI-V3

EVO_DATA_DIR=.evoagents
EVO_SANDBOX=auto

# Budgets for the full course tasks. Smaller values suit short demos.
EVO_MAX_STEPS=120
EVO_REQUEST_TIMEOUT=240
EVO_MAX_OUTPUT_TOKENS=16384
# Reasoning consumes the same output-token budget; keep effort bounded.
EVO_REASONING_EFFORT=low

# Optional: only read when a human approves git_push.
EVO_GITHUB_TOKEN=

# Disabled by default. Opt in to the DeepSeek backup after HKGAI
# network/402/429/5xx failures only when its separate key is configured.
EVO_DEEPSEEK_FALLBACK=false
